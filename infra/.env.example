# ShopIA — Variables de entorno (copiar a infra/.env)
APP_VERSION=v003-b
BACKEND_PORT=8000
BACKEND_HOST_OS=Mac
BACKEND_HOST_NAME=macbook-pro

# Autenticación sencilla (usuario único)
AUTH_ENABLED=true
AUTH_USERNAME=david
AUTH_PASSWORD=cambia_esta_clave
AUTH_SECRET=cambia_este_secreto_largo
AUTH_TOKEN_TTL_DAYS=90

# CORS (añade tu dominio de GitHub Pages, ej: https://largodav.github.io)
CORS_ORIGINS=http://localhost:5173,https://largodav.github.io

# PostgreSQL + pgvector
POSTGRES_USER=shopia
POSTGRES_PASSWORD=cambia_esta_clave_segura
POSTGRES_DB=shopia
POSTGRES_PORT=5432

# Ollama
# - Mac Apple Silicon (Ollama nativo en macOS): http://host.docker.internal:11434
# - Windows con Ollama en Docker (--profile nvidia): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_FAST_MODEL=gemma4-e2b-uncensored:latest
OLLAMA_ADVISOR_MODEL=gemma4-e2b-uncensored:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# Web Push (VAPID) — genera tus claves con:
# docker compose -f infra/docker-compose.yml exec backend python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shopia.local

# Tailscale (solo necesario si usas --profile tailscale dentro de Docker)
TS_HOSTNAME=shopia-backend
TS_AUTHKEY=
